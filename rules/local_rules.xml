<!-- Custom detection rules for the hybrid Wazuh lab.
     Rule IDs 100000+ are reserved for local rules. -->

<!-- Rule 100200: Windows Guest account enabled -->
<!-- Why: The Guest account is normally disabled. Enabling it can give an
     attacker an unauthenticated foothold or persistence.
     Source: Windows Security Event 4722 ("A user account was enabled").
     MITRE: T1078 (Valid Accounts) -->
<group name="windows,windows_security,account_changed,">
  <rule id="100200" level="12">
    <if_sid>60103</if_sid>
    <field name="win.system.eventID">^4722$</field>
    <field name="win.eventdata.targetUserName">^Guest$</field>
    <description>Windows Guest account was enabled.</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>windows_account_management,account_enabled,guest_account,</group>
  </rule>
</group>

<!-- Rule 100101: SSH brute-force correlation -->
<!-- Why: A single failed login (rule 5760) is usually a typo and too noisy
     to alert on. Three failures from the same source IP within 120 seconds
     is a better signal of automated guessing.
     MITRE: T1110 (Brute Force) -->
<group name="local,syslog,sshd,authentication_failed,">
  <rule id="100101" level="10" frequency="3" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <description>Multiple SSH login failures observed from the same source IP</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,ssh_bruteforce,credential_access,</group>
  </rule>
</group>